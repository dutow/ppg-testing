{% import '_shared.j2' as s %}
os_list: all
name_pattern: '{token}-{build}-{job}'
aws:
  size: large
  subnet: {{ subnet }}
cleanup: per-family
verifier:
  testinfra:
    directory: ../../../tests/tests_{{ 'psp' if flavor == 'psp' else 'ppg' }}
sequences:
  destroy:
  - destroy
  test:
  - destroy
  - create
  - prepare
  - converge
  - verify
  - cleanup
  - destroy
  cleanup:
  - cleanup
{{ s.server_params(flavor, major, default_version) }}
overrides:
{% for os in ['debian-11', 'debian-11-arm', 'debian-12', 'debian-12-arm'] %}
  {{ os }}:
{% if legacy_debian_overrides | default(false) %}
    emit_scenario_name: true
    cleanup: shared
    aws:
      size: small
    sequences:
      destroy:
      - destroy
      test:
      - destroy
      - create
      - prepare
      - converge
      - verify
      - destroy
      cleanup:
      - cleanup
{% else %}
    aws:
      size: small
{% endif %}
{% endfor %}
{% for os in ['debian-13', 'debian-13-arm'] %}
  {{ os }}:
    aws:
      size: small
    sequences:
      destroy:
      - destroy
      test:
      - destroy
      - create
      - prepare
      - converge
      - verify
      - destroy
      cleanup:
      - cleanup
{% endfor %}
  rhel-10:
    billing_tag: jenkins-pg-molecule-rhel
  rhel-10-arm:
    billing_tag: jenkins-pg-molecule-rhel
  rhel-8:
    billing_tag: jenkins-pg-molecule-rhel
  rhel-8-arm:
    billing_tag: jenkins-pg-molecule-rhel
  rhel-9:
    billing_tag: jenkins-pg-molecule-rhel
  rhel-9-arm:
    billing_tag: jenkins-pg-molecule-rhel
  ubuntu-jammy:
    aws:
      size: small
  ubuntu-jammy-arm:
    aws:
      size: small
  ubuntu-noble:
    aws:
      size: small
  ubuntu-noble-arm:
    aws:
      size: small
  ubuntu-resolute:
    aws:
      size: small
  ubuntu-resolute-arm:
    aws:
      size: small
